{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-pricing.local/contracts/application/chart_spec_v1.schema.json",
  "title": "Dynamic Pricing Chart Specification v1",
  "description": "A safe, backend-authored chart contract. The model may request a chart intent, but it never supplies executable chart code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chart_id", "type", "title", "description", "x_axis", "series", "points", "source", "model_implied"],
  "properties": {
    "schema_version": {"const": "pricing.chart.v1"},
    "chart_id": {"type": "string", "pattern": "^chart_[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "type": {"type": "string", "enum": ["line", "bar"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 400},
    "x_axis": {"$ref": "#/$defs/axis"},
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/series"}
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/point"}
    },
    "source": {"$ref": "#/$defs/chart_source"},
    "model_implied": {
      "type": "boolean",
      "description": "True whenever any plotted metric is model-implied rather than observed."
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "label", "value_type"],
      "properties": {
        "field": {"type": "string", "enum": ["candidate_price", "scenario", "final_action"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "value_type": {"type": "string", "enum": ["number", "string"]},
        "unit": {"type": "string", "enum": ["none", "currency", "count", "percentage"], "default": "none"}
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "label", "unit"],
      "properties": {
        "field": {
          "type": "string",
          "enum": ["candidate_price", "purchase_probability", "expected_quantity_if_purchase", "expected_units", "expected_revenue", "expected_gross_profit", "candidate_margin_pct", "price_change_percentage"]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "unit": {"type": "string", "enum": ["number", "currency", "count", "percentage"]},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "values"],
      "properties": {
        "x": {"type": ["number", "string"]},
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "value"],
            "properties": {
              "field": {
                "type": "string",
                "enum": ["candidate_price", "purchase_probability", "expected_quantity_if_purchase", "expected_units", "expected_revenue", "expected_gross_profit", "candidate_margin_pct", "price_change_percentage"]
              },
              "value": {"type": ["number", "null"]}
            }
          }
        }
      }
    },
    "chart_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "record_path", "data_status"],
      "properties": {
        "tool_name": {
          "type": "string",
          "enum": ["get_pricing_recommendation", "explain_pricing_recommendation", "simulate_price", "compare_price_scenarios", "search_recommendations", "get_model_performance", "get_business_rule_details", "get_current_inventory_insight"]
        },
        "record_path": {"type": "string", "pattern": "^[A-Za-z0-9._\\[\\]-]{1,160}$"},
        "data_status": {"type": "string", "enum": ["observed", "model_implied", "mixed"]}
      }
    }
  }
}
