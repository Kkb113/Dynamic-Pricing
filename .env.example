# Optional: leave blank for deterministic local fallback mode.
# Never commit a real key; FastAPI reads this value server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local loopback defaults. React must never receive OPENAI_API_KEY.
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
REACT_ORIGIN=http://localhost:5173
OPENAI_TIMEOUT_SECONDS=20
